rules_version = '2';

// ChatMize user uploaded images. Bucket: chatmize-uploads-246164058141.
// Images live under workspaces/{workspaceId}/images/ so each workspace's
// files stay organized and the path can be tightened to membership checks
// later without moving data.
//
// Current posture: any signed-in user can read and write images. Workspace
// membership is enforced at the app layer today (team ownership is not fully
// built yet); this rule blocks anonymous access and caps abuse via file size
// and content type. Tighten to per workspace membership when the backend
// ownership model lands.
service firebase.storage {
  match /b/{bucket}/o {
    match /workspaces/{workspaceId}/images/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');

      allow delete: if request.auth != null;
    }

    // Deny everything outside the workspace image folders.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
