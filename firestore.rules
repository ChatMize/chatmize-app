rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Super Admin is granted via Firebase Auth custom claim: { superadmin: true }.
    // Claims are set by a Cloud Function (Phase 3); until then no account
    // carries the claim and these branches stay closed.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superadmin == true;
    }

    // Phase 3 tenancy model: every workspace has a members subcollection of uids.
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    // Platform user profiles
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isSuperAdmin();
    }

    // Workspaces and everything nested under them (Phase 3 tenancy model)
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
      match /{document=**} {
        allow read, write: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      }
    }

    // Delivery board (Super Admin Kanban incl. qaNotes). Authenticated-only for
    // now; Phase 3 restricts this to the superadmin custom claim once client
    // role gating lands, so Karl's access never breaks mid-migration.
    match /system_settings/{docId} {
      // Read: any signed-in user (admin UI reads). Write: Super Admin only.
      // The one-time bootstrap doc is written by the bootstrapSuperAdmin
      // callable via the Admin SDK (bypasses rules).
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Commercial plans: public read (pricing page), Super Admin write.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // AI credit balances: members can read their own workspace; only the
    // backend (Admin SDK) writes. Same for the immutable ledger.
    match /credit_balances/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      allow write: if false;
    }
    match /credit_ledger/{workspaceId}/entries/{entryId} {
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      allow write: if false;
    }

    // Snapshots: any signed-in user can read (link sharing + template
    // library). Owners can create/edit/delete their own; Super Admin can
    // curate (feature templates, moderate).
    match /snapshots/{snapshotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.createdByUid == request.auth.uid || isSuperAdmin());
    }

    // SMS: connection + logs are backend-written; members can read their
    // own workspace. Opt-ins are member-readable (audience counts).
    match /sms_connections/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      allow write: if false;
    }
    match /sms_optins/{optInId} {
      allow read: if isSignedIn()
        && (isWorkspaceMember(resource.data.workspaceId) || isSuperAdmin());
      allow write: if false;
    }
    match /sms_logs/{workspaceId}/entries/{entryId} {
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      allow write: if false;
    }

    // Legacy top-level collections (pre-tenancy data model). Authenticated-only;
    // Phase 3 migrates these under workspaces/{workspaceId}/... at which point
    // these branches are removed.
    match /contacts/{contactId} {
      allow read, write: if isSignedIn();
    }
    match /campaigns/{campaignId} {
      allow read, write: if isSignedIn();
    }
    match /deletion_audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    // send.chat link cloaker: cloaked link docs live in a top-level
    // collection (schema contract with the Growth suite UI). Authenticated
    // read/write for now; the app enforces workspace scoping client-side.
    // Membership tightening is a separate queued task.
    match /cloaked_links/{linkId} {
      allow read, write: if isSignedIn();
    }

    // Connectivity probe: readable when signed in, never writable from clients.
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Waitlist signups: written only by the backend (Admin SDK) via the
    // public waitlist API. Super Admin can read for the admin list/export.
    match /waitlist_signups/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Waitlist rate limits: backend-only bookkeeping, never client readable.
    match /waitlist_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Website Overlays SDK (overlays.js): the published config snapshot is
    // read directly from Firestore by the unauthenticated snippet, so it is
    // public-read. Only the backend publishes it (Admin SDK bypasses rules);
    // clients can never write it. Stats are member-read, backend-write only.
    match /overlayConfigs/{workspaceId} {
      allow read: if true;
      allow write: if false;
    }
    match /overlayStats/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      allow write: if false;
    }

    // Explicit deny-all catch-all. (Firestore denies by default when no rule
    // matches; this makes the posture visible in the file itself.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
